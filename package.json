{
  "type": "module",
  "scripts": {
    "test": "node --test",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "lint": "eslint \"js/**/*.js\" \"tests/**/*.js\" --max-warnings=0 && npm run audit:html-sinks",
    "benchmark:map": "node benchmarks/mapProjectionBenchmark.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "validate": "npm test && npm run lint && npm run build",
    "audit": "npm audit --audit-level=high",
    "format:check": "npm run lint",
    "test:persistence": "node --test tests/persistence.test.js",
    "test:worldgen": "node --test tests/worldgenGateEconomy.test.js tests/worldgenClusters.test.js",
    "test:ui-core": "node --test tests/uiLifecycle.test.js tests/renderEscaping.test.js",
    "benchmark:all": "npm run benchmark:map",
    "docs:drift": "node scripts/docs-drift-check.mjs",
    "audit:html-sinks": "node scripts/audit-html-sinks.mjs",
    "test:worldgen:stress": "ST_WORLDGEN_STRESS=1 node --test tests/worldgenGateEconomy.test.js tests/worldgenClusters.test.js"
  },
  "devDependencies": {
    "eslint": "9.39.4",
    "vite": "6.4.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.4.2"
}
